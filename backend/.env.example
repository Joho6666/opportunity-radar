APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54329/opportunity_radar
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# 本机单用户模式：只接受来自 127.0.0.1/::1 的直连请求；APP_ENV=production 时拒绝启动。
AUTH_DISABLED=false
LOCAL_USER_ID=00000000-0000-0000-0000-000000000001
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FAST_MODEL=
FIRECRAWL_API_KEY=
GITHUB_TOKEN=
TIKHUB_API_KEY=
RSS_FEEDS=https://hnrss.org/newest,https://github.blog/feed/
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
USE_IN_MEMORY_STORE=false

# Money Intelligence (Phase 1)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
SIMHASH_DISTANCE_THRESHOLD=12
CLUSTER_SIMILARITY_THRESHOLD=0.82
BREAKOUT_Z_THRESHOLD=3.0
BREAKOUT_MIN_BASELINE=2.0
MONEY_SCORE_WEIGHTS_JSON=
INFORMATION_EDGE_WEIGHTS_JSON=
INCLUDE_MOCK_COLLECTOR=false

# P0 cost-funnel gates
ENABLE_RELEVANCE_GATE=true            # Stage 1 embedding relevance gate (auto-off without embeddings)
RELEVANCE_SIMILARITY_THRESHOLD=0.30   # below this vs. the radar topic vector → skip the LLM
LLM_PRICE_INPUT_PER_MTOK=0.0          # USD per 1M input tokens; 0 refuses paid LLM calls
LLM_PRICE_OUTPUT_PER_MTOK=0.0

# P1 guardrails
LLM_DAILY_TOKEN_BUDGET=0              # per-user daily token budget; 0 = unlimited (circuit breaker → rule path)
RETENTION_RAW_ITEMS_DAYS=90           # 0 = keep forever
RETENTION_LLM_CALLS_DAYS=30           # 0 = keep forever

# 本机开着 Clash/Mihomo 等 fake-IP 代理（域名都解析成 198.18.x.x）时设为 true，否则采集会被 SSRF 防护拦下。仅限本机。
ALLOW_FAKE_IP_DNS=false

# All paid providers including AI are disabled until explicitly authorized.
PAID_API_ENABLED=false
PAID_DAILY_COST_LIMIT=1.0
PAID_DAILY_REQUEST_LIMIT=20
TIKHUB_PRICE_PER_REQUEST=0
FIRECRAWL_PRICE_PER_REQUEST=0
EMBEDDING_PRICE_PER_MTOK=0
LLM_MAX_OUTPUT_TOKENS=800
ALLOW_RETENTION_DELETE=false

ENABLE_AI_CLASSIFICATION=false
